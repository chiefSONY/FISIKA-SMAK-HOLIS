<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sony Kristanto · Physics Educator · Live Streaming</title>
  <!-- Font & ikon -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      background: #0b141a;
      position: relative;
      background-image: 
        radial-gradient(ellipse at 20% 50%, rgba(0, 180, 255, 0.06) 0%, transparent 60%),
        radial-gradient(ellipse at 80% 20%, rgba(100, 0, 255, 0.05) 0%, transparent 50%),
        radial-gradient(ellipse at 50% 80%, rgba(0, 255, 200, 0.03) 0%, transparent 50%);
    }

    /* latar belakang futuristik */
    .bg-grid {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image: 
        linear-gradient(rgba(0, 255, 255, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 255, 255, 0.03) 1px, transparent 1px);
      background-size: 60px 60px;
      z-index: 0;
      pointer-events: none;
    }

    .bg-glow {
      position: fixed;
      top: -20%;
      right: -10%;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(0, 150, 255, 0.08) 0%, transparent 70%);
      border-radius: 50%;
      z-index: 0;
      pointer-events: none;
      animation: pulseGlow 8s ease-in-out infinite alternate;
    }

    .bg-glow-2 {
      position: fixed;
      bottom: -20%;
      left: -10%;
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, rgba(100, 0, 255, 0.06) 0%, transparent 70%);
      border-radius: 50%;
      z-index: 0;
      pointer-events: none;
      animation: pulseGlow 10s ease-in-out infinite alternate-reverse;
    }

    @keyframes pulseGlow {
      0% { opacity: 0.4; transform: scale(1); }
      100% { opacity: 1; transform: scale(1.2); }
    }

    /* container utama: flex row untuk profil + streaming */
    .main-container {
      position: relative;
      z-index: 1;
      max-width: 1400px;
      width: 100%;
      display: flex;
      flex-wrap: wrap;
      gap: 1.8rem;
      align-items: stretch;
    }

    /* kartu profil — glassmorphism futuristik (sebelah kiri) */
    .card {
      flex: 1 1 480px;
      min-width: 320px;
      background: rgba(10, 20, 30, 0.6);
      backdrop-filter: blur(24px) saturate(1.2);
      -webkit-backdrop-filter: blur(24px) saturate(1.2);
      border-radius: 2.5rem;
      border: 1px solid rgba(0, 200, 255, 0.15);
      box-shadow: 
        0 40px 80px -20px rgba(0, 0, 0, 0.8),
        inset 0 1px 0 rgba(255, 255, 255, 0.05),
        0 0 60px rgba(0, 150, 255, 0.05);
      padding: 2.8rem 2.8rem 2.5rem;
      transition: transform 0.4s ease, box-shadow 0.5s ease;
    }

    .card:hover {
      transform: translateY(-4px);
      box-shadow: 
        0 50px 100px -20px rgba(0, 0, 0, 0.9),
        inset 0 1px 0 rgba(255, 255, 255, 0.08),
        0 0 80px rgba(0, 150, 255, 0.08);
    }

    /* ===== STREAMING PANEL (sebelah kanan) ===== */
    .stream-panel {
      flex: 1 1 480px;
      min-width: 320px;
      background: rgba(10, 20, 30, 0.5);
      backdrop-filter: blur(20px) saturate(1.1);
      -webkit-backdrop-filter: blur(20px) saturate(1.1);
      border-radius: 2.5rem;
      border: 1px solid rgba(0, 200, 255, 0.12);
      box-shadow: 
        0 40px 80px -20px rgba(0, 0, 0, 0.7),
        inset 0 1px 0 rgba(255, 255, 255, 0.03),
        0 0 60px rgba(0, 150, 255, 0.04);
      padding: 1.8rem 1.8rem 1.8rem;
      display: flex;
      flex-direction: column;
      transition: transform 0.4s ease, box-shadow 0.5s ease;
    }

    .stream-panel:hover {
      transform: translateY(-4px);
      box-shadow: 
        0 50px 100px -20px rgba(0, 0, 0, 0.8),
        inset 0 1px 0 rgba(255, 255, 255, 0.05),
        0 0 80px rgba(0, 150, 255, 0.08);
    }

    .stream-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1rem;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .stream-header .title {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      color: #b0dfff;
      font-weight: 600;
      font-size: 1.1rem;
      letter-spacing: 0.3px;
    }

    .stream-header .title i {
      color: #4db8ff;
      font-size: 1.2rem;
    }

    .stream-status {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.8rem;
      color: #6a9ab0;
      background: rgba(0, 200, 255, 0.04);
      padding: 0.2rem 0.8rem 0.2rem 0.6rem;
      border-radius: 40px;
      border: 1px solid rgba(0, 200, 255, 0.06);
    }

    .status-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #00ff88;
      animation: blink 1.4s infinite;
      box-shadow: 0 0 12px rgba(0, 255, 136, 0.3);
    }

    @keyframes blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.2; }
    }

    /* video wrapper */
    .video-wrapper {
      flex: 1;
      min-height: 340px;
      background: rgba(0, 0, 0, 0.4);
      border-radius: 1.8rem;
      overflow: hidden;
      border: 1px solid rgba(0, 200, 255, 0.06);
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .video-wrapper video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      background: #0a1218;
    }

    .video-wrapper .placeholder {
      position: absolute;
      color: #4a7a8f;
      font-size: 1rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.8rem;
      pointer-events: none;
    }

    .video-wrapper .placeholder i {
      font-size: 3rem;
      color: rgba(77, 184, 255, 0.15);
    }

    /* control bar kecil di bawah video */
    .stream-controls {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 1rem;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .stream-controls .info {
      font-size: 0.75rem;
      color: #4a7a8f;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .stream-controls .info i {
      color: #4db8ff;
    }

    .stream-controls .actions {
      display: flex;
      gap: 0.5rem;
    }

    .stream-controls .actions a {
      color: #6a9ab0;
      background: rgba(255, 255, 255, 0.02);
      padding: 0.3rem 0.9rem;
      border-radius: 40px;
      font-size: 0.75rem;
      text-decoration: none;
      border: 1px solid rgba(255, 255, 255, 0.03);
      transition: 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
    }

    .stream-controls .actions a:hover {
      background: rgba(0, 200, 255, 0.04);
      border-color: rgba(0, 200, 255, 0.1);
      color: #b0dfff;
    }

    /* ===== PROFIL CARD (isi sama seperti sebelumnya) ===== */
    .profile-header {
      display: flex;
      align-items: center;
      gap: 1.4rem;
      flex-wrap: wrap;
      margin-bottom: 1.5rem;
    }

    .avatar {
      width: 4.8rem;
      height: 4.8rem;
      border-radius: 1.8rem;
      background: linear-gradient(135deg, rgba(0, 200, 255, 0.15), rgba(100, 0, 255, 0.15));
      border: 1px solid rgba(0, 200, 255, 0.25);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.4rem;
      color: #7fd4ff;
      box-shadow: 0 0 30px rgba(0, 150, 255, 0.08);
      backdrop-filter: blur(4px);
    }

    .name-title h1 {
      font-size: 2.6rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      background: linear-gradient(135deg, #ffffff 30%, #7fd4ff 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      line-height: 1.1;
    }

    .name-title .badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(0, 200, 255, 0.08);
      padding: 0.2rem 1rem 0.2rem 0.8rem;
      border-radius: 40px;
      font-size: 0.8rem;
      font-weight: 500;
      color: #8bcbff;
      border: 1px solid rgba(0, 200, 255, 0.1);
      letter-spacing: 0.3px;
      margin-top: 0.2rem;
    }

    .badge i {
      color: #4db8ff;
      font-size: 0.7rem;
    }

    .profesi-block {
      display: inline-flex;
      align-items: center;
      gap: 0.8rem;
      background: linear-gradient(135deg, rgba(0, 180, 255, 0.12), rgba(80, 0, 255, 0.08));
      padding: 0.6rem 1.8rem 0.6rem 1.4rem;
      border-radius: 60px;
      border: 1px solid rgba(0, 200, 255, 0.2);
      margin: 0.8rem 0 1.2rem 0;
      backdrop-filter: blur(4px);
      box-shadow: 0 0 40px rgba(0, 150, 255, 0.04);
    }

    .profesi-block i {
      color: #4db8ff;
      font-size: 1.4rem;
    }

    .profesi-block span {
      color: #e8f4ff;
      font-weight: 700;
      font-size: 1.5rem;
      letter-spacing: -0.01em;
    }

    .profesi-block .sub {
      font-weight: 300;
      font-size: 0.95rem;
      color: #8bcbff;
      margin-left: 0.2rem;
      opacity: 0.8;
    }

    .school-block {
      display: inline-flex;
      align-items: center;
      gap: 0.7rem;
      background: rgba(0, 255, 200, 0.04);
      padding: 0.4rem 1.4rem 0.4rem 1rem;
      border-radius: 40px;
      border: 1px solid rgba(0, 255, 200, 0.08);
      margin-top: -0.2rem;
      margin-bottom: 1.2rem;
    }

    .school-block i {
      color: #4dd4ff;
      font-size: 1rem;
    }

    .school-block .school-name {
      color: #b0dfff;
      font-weight: 500;
      font-size: 0.95rem;
      letter-spacing: 0.2px;
    }

    .school-block .brand {
      color: #7fd4ff;
      font-weight: 700;
      font-size: 0.8rem;
      background: rgba(0, 200, 255, 0.08);
      padding: 0.1rem 0.8rem;
      border-radius: 30px;
      border: 1px solid rgba(0, 200, 255, 0.1);
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .bio {
      margin: 1.2rem 0 1.8rem 0;
    }

    .bio p {
      font-size: 1.05rem;
      color: #c8dce8;
      font-weight: 400;
      line-height: 1.6;
      max-width: 90%;
      padding: 0.4rem 0;
      border-left: 2px solid rgba(0, 200, 255, 0.15);
      padding-left: 1.2rem;
      opacity: 0.9;
    }

    .bio p i {
      color: #4db8ff;
      margin-right: 0.6rem;
      opacity: 0.7;
    }

    .spec-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
      gap: 0.7rem;
      margin: 1.8rem 0 1.8rem 0;
    }

    .spec-item {
      background: rgba(255, 255, 255, 0.02);
      backdrop-filter: blur(4px);
      border-radius: 40px;
      padding: 0.5rem 1rem;
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-weight: 400;
      color: #bdd8e8;
      border: 1px solid rgba(255, 255, 255, 0.04);
      font-size: 0.85rem;
      transition: 0.2s ease;
    }

    .spec-item i {
      color: #4db8ff;
      font-size: 1rem;
      width: 1.2rem;
      text-align: center;
    }

    .spec-item:hover {
      background: rgba(0, 200, 255, 0.04);
      border-color: rgba(0, 200, 255, 0.12);
      transform: translateY(-2px);
      box-shadow: 0 8px 20px -12px rgba(0, 150, 255, 0.1);
    }

    .quote {
      margin: 1.6rem 0 2rem 0;
      padding: 1rem 1.8rem;
      background: rgba(0, 200, 255, 0.02);
      border-radius: 30px;
      border-left: 3px solid rgba(0, 200, 255, 0.2);
      border: 1px solid rgba(0, 200, 255, 0.04);
      border-left: 3px solid rgba(0, 200, 255, 0.25);
      font-style: italic;
      color: #c0dcec;
      font-weight: 300;
      font-size: 1.05rem;
      backdrop-filter: blur(4px);
      text-align: center;
    }

    .quote i {
      color: #4db8ff;
      margin-right: 0.6rem;
      opacity: 0.6;
    }

    .quote .highlight {
      color: #7fd4ff;
      font-weight: 600;
      font-style: normal;
    }

    .social-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.7rem 1rem;
      margin-top: 1rem;
      align-items: center;
    }

    .social-links a {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      text-decoration: none;
      color: #b0dfff;
      background: rgba(255, 255, 255, 0.02);
      backdrop-filter: blur(4px);
      padding: 0.4rem 1.2rem 0.4rem 1rem;
      border-radius: 50px;
      font-weight: 400;
      font-size: 0.85rem;
      border: 1px solid rgba(255, 255, 255, 0.04);
      transition: all 0.25s ease;
    }

    .social-links a i {
      font-size: 1.1rem;
      color: #4db8ff;
    }

    .social-links a:hover {
      background: rgba(0, 200, 255, 0.06);
      border-color: rgba(0, 200, 255, 0.15);
      transform: translateY(-2px);
      box-shadow: 0 8px 25px -12px rgba(0, 150, 255, 0.15);
      color: #e8f4ff;
    }

    .social-links .btn-email {
      background: rgba(0, 180, 255, 0.06);
      border-color: rgba(0, 180, 255, 0.12);
    }

    .social-links .btn-email i {
      color: #7fd4ff;
    }

    .social-links .btn-email:hover {
      background: rgba(0, 180, 255, 0.12);
      border-color: rgba(0, 180, 255, 0.25);
    }

    .footer-note {
      margin-top: 2.2rem;
      font-size: 0.7rem;
      color: #4a7a8f;
      border-top: 1px solid rgba(255, 255, 255, 0.03);
      padding-top: 1.2rem;
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.5rem;
      letter-spacing: 0.5px;
    }

    .footer-note i {
      margin-right: 0.3rem;
      color: #3a7a8f;
    }

    /* school building (di profil) */
    .school-building {
      margin: 1.2rem 0 0.2rem 0;
      border-radius: 2rem;
      overflow: hidden;
      position: relative;
      background: linear-gradient(135deg, rgba(0, 40, 60, 0.3), rgba(10, 20, 40, 0.5));
      border: 1px solid rgba(0, 200, 255, 0.06);
      backdrop-filter: blur(4px);
      min-height: 100px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0.8rem 1.5rem;
    }

    .building-visual {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.8rem;
      flex-wrap: wrap;
      width: 100%;
    }

    .building-icon {
      font-size: 3.2rem;
      color: rgba(77, 184, 255, 0.12);
      display: flex;
      gap: 0.6rem;
      align-items: center;
    }

    .building-info {
      text-align: left;
      flex: 1;
      min-width: 160px;
    }

    .building-info .name {
      font-weight: 700;
      font-size: 1.1rem;
      color: #d4ecff;
      letter-spacing: -0.01em;
    }

    .building-info .name i {
      color: #4db8ff;
      margin-right: 0.4rem;
      font-size: 0.9rem;
    }

    .building-info .address {
      font-size: 0.75rem;
      color: #6a9ab0;
      margin-top: 0.1rem;
      font-weight: 300;
    }

    .building-info .brand-tag {
      display: inline-block;
      margin-top: 0.2rem;
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: #4db8ff;
      background: rgba(0, 200, 255, 0.06);
      padding: 0.1rem 0.8rem;
      border-radius: 30px;
      border: 1px solid rgba(0, 200, 255, 0.06);
    }

    .school-badge-foto {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: rgba(0, 200, 255, 0.04);
      padding: 0.1rem 0.8rem 0.1rem 0.6rem;
      border-radius: 40px;
      border: 1px solid rgba(0, 200, 255, 0.06);
      margin-top: 0.2rem;
    }

    .school-badge-foto i {
      color: #4db8ff;
      font-size: 0.6rem;
    }

    .school-badge-foto span {
      color: #7fd4ff;
      font-weight: 600;
      font-size: 0.65rem;
      letter-spacing: 0.5px;
    }

    .building-line {
      width: 100%;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(0, 200, 255, 0.06), transparent);
      margin: 0.2rem 0;
    }

    /* responsive */
    @media (max-width: 900px) {
      .main-container {
        flex-direction: column;
      }
      .card, .stream-panel {
        flex: 1 1 auto;
        width: 100%;
      }
      .stream-panel {
        min-height: 340px;
      }
      .video-wrapper {
        min-height: 280px;
      }
    }

    @media (max-width: 600px) {
      .card {
        padding: 1.8rem 1.2rem;
        border-radius: 1.8rem;
      }
      .stream-panel {
        padding: 1.2rem;
        border-radius: 1.8rem;
      }
      .name-title h1 {
        font-size: 2rem;
      }
      .profesi-block span {
        font-size: 1.1rem;
      }
      .bio p {
        max-width: 100%;
        font-size: 0.95rem;
        padding-left: 0.8rem;
      }
      .spec-grid {
        grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
      }
      .building-visual {
        flex-direction: column;
        text-align: center;
      }
      .building-info {
        text-align: center;
      }
      .social-links a {
        font-size: 0.8rem;
        padding: 0.3rem 0.9rem;
      }
      .quote {
        font-size: 0.95rem;
        padding: 0.8rem 1.2rem;
      }
      .video-wrapper {
        min-height: 220px;
      }
    }
  </style>
</head>
<body>

  <!-- elemen latar -->
  <div class="bg-grid"></div>
  <div class="bg-glow"></div>
  <div class="bg-glow-2"></div>

  <div class="main-container">
    <!-- ===== KARTU PROFIL (kiri) ===== -->
    <div class="card">
      <div class="profile-header">
        <div class="avatar">
          <i class="fas fa-user-astronaut"></i>
        </div>
        <div class="name-title">
          <h1>Sony Kristanto</h1>
          <div class="badge">
            <i class="fas fa-map-pin"></i> Bandung · Indonesia
          </div>
        </div>
      </div>

      <div class="profesi-block">
        <i class="fas fa-atom"></i>
        <span>Physics Educator</span>
        <span class="sub">· membangun generasi saintis</span>
      </div>

      <div class="school-block">
        <i class="fas fa-school"></i>
        <span class="school-name">SMA BPK PENABUR HOLIS Bandung</span>
        <span class="brand"><i class="fas fa-rocket" style="margin-right: 4px;"></i> School of Future</span>
      </div>

      <div class="bio">
        <p>
          <i class="fas fa-quote-left" style="opacity: 0.5;"></i> 
          Membimbing generasi memahami alam semesta, satu eksperimen dan persamaan pada satu waktu.
        </p>
      </div>

      <!-- school building -->
      <div class="school-building">
        <div class="building-visual">
          <div class="building-icon">
            <i class="fas fa-building"></i>
            <i class="fas fa-school" style="opacity: 0.7;"></i>
            <i class="fas fa-graduation-cap" style="opacity: 0.5;"></i>
          </div>
          <div class="building-info">
            <div class="name">
              <i class="fas fa-location-dot"></i> SMA BPK PENABUR HOLIS
            </div>
            <div class="address">
              Komplek Taman Holis Indah Blok A, Cigondewah Kidul, Bandung Kulon, Kota Bandung 40214
            </div>
            <div class="brand-tag">
              <i class="fas fa-arrow-right"></i> School of Future · Center of Excellence
            </div>
            <div class="school-badge-foto">
              <i class="fas fa-star"></i>
              <span>SCHOOL OF FUTURE · LIGHTS the Future</span>
              <i class="fas fa-star" style="opacity: 0.5;"></i>
            </div>
          </div>
          <div style="display: flex; gap: 0.4rem; font-size: 1.2rem; color: rgba(77, 184, 255, 0.06);">
            <i class="fas fa-circle"></i>
            <i class="fas fa-circle"></i>
            <i class="fas fa-circle"></i>
          </div>
        </div>
      </div>

      <div class="building-line"></div>

      <!-- spesialisasi -->
      <div class="spec-grid">
